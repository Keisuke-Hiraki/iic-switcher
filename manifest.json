{
  "manifest_version": 3,
  "name": "IIC Switcher",
  "description": "複数のIAM Identity Centerアクセスポータルへ1画面からログイン",
  "version": "0.1.0",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*.awsapps.com/*", "https://*.signin.aws/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IIC Switcher"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon/iic-swtcher-logo16.png",
    "48": "icon/iic-swtcher-logo48.png",
    "128": "icon/iic-swtcher-logo128.png"
  }
}
